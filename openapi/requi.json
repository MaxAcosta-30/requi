  "components": {
    "schemas": {
      "AvisoDto": {
        "required": [
          "id",
          "proveedorId",
          "proveedor",
          "ordenId",
          "asunto",
          "cuerpo",
          "creadoEn"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "proveedorId": {
            "type": "string",
            "format": "uuid"
          },
          "proveedor": {
            "type": "string"
          },
          "ordenId": {
            "type": "string",
            "format": "uuid"
          },
          "asunto": {
            "type": "string"
          },
          "cuerpo": {
            "type": "string"
          },
          "creadoEn": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "EventoDto": {
        "required": [
          "fecha",
          "actorId",
          "accion",
          "datos"
        ],
        "type": "object",
        "properties": {
          "fecha": {
            "type": "string",
            "format": "date-time"
          },
          "actorId": {
            "type": "string",
            "format": "uuid"
          },
          "accion": {
            "type": "string"
          },
          "datos": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "FirmaDto": {
        "required": [
          "aprobadorId",
          "decision",
          "motivo",
          "fecha"
        ],
        "type": "object",
        "properties": {
          "aprobadorId": {
            "type": "string",
            "format": "uuid"
          },
          "decision": {
            "type": "string"
          },
          "motivo": {
            "type": [
              "null",
              "string"
            ]
          },
          "fecha": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "HttpValidationProblemDetails": {
        "type": "object",
        "properties": {
          "type": {
            "type": [
              "null",
              "string"
            ]
          },
          "title": {
            "type": [
              "null",
              "string"
            ]
          },
          "status": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "null",
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "detail": {
            "type": [
              "null",
              "string"
            ]
          },
          "instance": {
            "type": [
              "null",
              "string"
            ]
          },
          "errors": {
            "type": "object",
            "additionalProperties": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        }
      },
      "MensajeDto": {
        "required": [
          "id",
          "tipo",
          "estado",
          "intentos",
          "ultimoError",
          "ocurrioEn",
          "procesadoEn"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "tipo": {
            "type": "string"
          },
          "estado": {
            "type": "string"
          },
          "intentos": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "ultimoError": {
            "type": [
              "null",
              "string"
            ]
          },
          "ocurrioEn": {
            "type": "string",
            "format": "date-time"
          },
          "procesadoEn": {
            "type": [
              "null",
              "string"
            ],
            "format": "date-time"
          }
        }
      },
      "OrdenDto": {
        "required": [
          "id",
          "folio",
          "requisicionId",
          "proveedorId",
          "proveedor",
          "total",
          "creadaEn"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "folio": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int64"
          },
          "requisicionId": {
            "type": "string",
            "format": "uuid"
          },
          "proveedorId": {
            "type": "string",
            "format": "uuid"
          },
          "proveedor": {
            "type": "string"
          },
          "total": {
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?$",
            "type": [
              "number",
              "string"
            ],
            "format": "double"
          },
          "creadaEn": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "ProductoDto": {
        "required": [
          "id",
          "proveedorId",
          "proveedor",
          "sku",
          "nombre",
          "unidad",
          "precioUnitario",
          "activo"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "proveedorId": {
            "type": "string",
            "format": "uuid"
          },
          "proveedor": {
            "type": "string"
          },
          "sku": {
            "type": "string"
          },
          "nombre": {
            "type": "string"
          },
          "unidad": {
            "type": "string"
          },
          "precioUnitario": {
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?$",
            "type": [
              "number",
              "string"
            ],
            "format": "double"
          },
          "activo": {
            "type": "boolean"
          }
        }
      },
      "ProductoEntrada": {
        "required": [
          "proveedorId",
          "sku",
          "nombre",
          "unidad",
          "precioUnitario"
        ],
        "type": "object",
        "properties": {
          "proveedorId": {
            "type": "string",
            "format": "uuid"
          },
          "sku": {
            "type": "string"
          },
          "nombre": {
            "type": "string"
          },
          "unidad": {
            "type": "string"
          },
          "precioUnitario": {
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?$",
            "type": [
              "number",
              "string"
            ],
            "format": "double"
          }
        }
      },
