            "type": "string",
            "format": "uuid"
          },
          "sku": {
            "type": "string"
          },
          "nombre": {
            "type": "string"
          },
          "unidad": {
            "type": "string"
          },
          "precioUnitario": {
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?$",
