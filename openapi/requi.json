        "required": [
          "id",
          "nombre",
          "correo",
          "telefono",
          "activo"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "nombre": {
            "type": "string"
          },
          "correo": {
            "type": "string"
