<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="dbup-postgresql" Version="7.0.1" />
  </ItemGroup>

  <ItemGroup>
    <!-- El nombre lógico es el del archivo: así queda registrado en schemaversions. -->
    <EmbeddedResource Include="..\..\database\scripts\*.sql" LogicalName="%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
